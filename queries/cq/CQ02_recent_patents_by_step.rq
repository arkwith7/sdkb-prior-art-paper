# desc: 특정 시점(2021년) 이후 출원된 특허를 공정 단계와 함께 조회할 수 있는가? (시계열의 전제)
# expect-min: 1
PREFIX sdkb: <https://w3id.org/sdkb#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
SELECT ?patent ?date ?step
WHERE {
  ?patent a sdkb:Patent ;
          sdkb:filingDate ?date ;
          sdkb:appliesToProcessStep ?step .
  FILTER(?date >= "2021-01-01"^^xsd:date)
}
ORDER BY ?date
