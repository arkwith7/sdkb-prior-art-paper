# 특허 인스턴스 필수 제약: 출원번호 1개, 출원일 1개(date), 공정 링크 1개 이상.
# 어휘는 SDKB v1.0 실물 (ont:) — 새 술어를 발명하지 않는다.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ont:  <https://w3id.org/sdkb/ont/> .
@prefix pat:  <https://w3id.org/sdkb/data/patent/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

pat:PatentShape a sh:NodeShape ;
    sh:targetClass ont:Patent ;
    sh:property [
        sh:path ont:applicationNumber ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ont:filingDate ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
        sh:message "특허는 filingDate(xsd:date)가 정확히 1개 있어야 함 — foresight 시계열의 전제" ;
    ] ;
    # SubProcess ⊑ Process 이므로, RDFS 추론(shacl_gate 의 inference="rdfs") 하에서
    # 이 제약은 상위 Process 링크와 하위 SubProcess 링크를 모두 허용한다.
    sh:property [
        sh:path ont:realizesProcess ;
        sh:minCount 1 ; sh:class ont:Process ;
        sh:message "특허는 최소 1개 공정(Process 또는 SubProcess)에 매핑되어야 함 — 커버리지 분석의 전제" ;
    ] .
