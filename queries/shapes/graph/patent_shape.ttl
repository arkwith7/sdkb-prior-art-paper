# L1 — 그래프 전체(G₀·G₁)에 적용되는 특허 제약.
#
# 이 그래프에는 **레거시 SIRP 특허 1,000건**이 들어 있다. 그중 118건은 공정 링크가 없는데,
# IPC 가 G11C(기억장치 회로)·H10B/H10D(반도체 소자) 같은 **소자 분류**이기 때문이다 —
# 데이터 결함이 아니라 그들이 디바이스 특허라는 사실이다. 공정으로 억지 매핑하는 것은
# 날조이므로(CLAUDE.md §1.2), 그래프 전체에는 아래 두 가지만 요구한다.
#
# 개념 매핑(Process ∪ Device) ≥1 은 **이 논문이 병합하는 델타**에만 엄격히 요구한다
#   → queries/shapes/delta/patent_delta_shape.ttl
#
# 어휘는 SDKB v1.0 실물 (ont:) — 새 술어를 발명하지 않는다.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ont:  <https://w3id.org/sdkb/ont/> .
@prefix pat:  <https://w3id.org/sdkb/data/patent/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

pat:PatentShape a sh:NodeShape ;
    sh:targetClass ont:Patent ;
    sh:property [
        sh:path ont:applicationNumber ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ont:filingDate ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
        sh:message "특허는 filingDate(xsd:date)가 정확히 1개 있어야 함 — foresight 시계열의 전제" ;
    ] .
