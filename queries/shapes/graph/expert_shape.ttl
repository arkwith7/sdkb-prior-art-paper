# L1 — 그래프 전체(G₀·G₁·G₂)에 적용되는 인력 축(전문가 상세 경력) 제약.
#
# 상류 SDKB 가 curated_profiles_kr.json 의 상세 경력을 A-Box 로 실체화했다(2026-07-21):
# 경력 datatype 22종 · EquipmentModel(장비 모델) · ExpertCase(사례 reification).
# 이 shape 는 그 신규 어휘가 **게이트에 보이게** 하고(§5.2 — 아무도 안 보는 어휘 0),
# 자료형·range 가 옳게 실렸음을 고정한다.
#
# 값은 전부 비식별 변조/생성값이다 (SDKB docs/deidentification_protocol.md §1.5) —
# 이 shape 는 그 사실을 바꾸지 않고, 구조 정합만 검증한다.
# 어휘는 SDKB v1.0 실물 (ont:) — 새 술어를 발명하지 않는다.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ont:  <https://w3id.org/sdkb/ont/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ─── EquipmentModel: 이름이 있어야 한다 ──────────────────────────
ont:Shape_EquipmentModel a sh:NodeShape ;
    sh:targetClass ont:EquipmentModel ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "EquipmentModel must have a language-tagged skos:prefLabel." ;
    ] .

# ─── ExpertCase: 이름 + 출처 + 링크 range ────────────────────────
ont:Shape_ExpertCase a sh:NodeShape ;
    sh:targetClass ont:ExpertCase ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:datatype rdf:langString ;
        sh:message "ExpertCase must have a language-tagged skos:prefLabel." ] ;
    sh:property [ sh:path ont:caseSource ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "ExpertCase must record caseSource (provenance)." ] ;
    sh:property [ sh:path ont:caseProcess ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class ont:Process ] [ sh:class ont:SubProcess ] ) ;
        sh:message "caseProcess range must be Process or SubProcess." ] ;
    sh:property [ sh:path ont:caseFailureMode ; sh:class ont:FailureMode ; sh:nodeKind sh:IRI ;
        sh:message "caseFailureMode range must be FailureMode." ] ;
    sh:property [ sh:path ont:caseRootCause ; sh:class ont:RootCause ; sh:nodeKind sh:IRI ;
        sh:message "caseRootCause range must be RootCause." ] ;
    sh:property [ sh:path ont:caseMitigation ; sh:class ont:Mitigation ; sh:nodeKind sh:IRI ;
        sh:message "caseMitigation range must be Mitigation." ] ;
    sh:property [ sh:path ont:caseParameter ; sh:class ont:Parameter ; sh:nodeKind sh:IRI ;
        sh:message "caseParameter range must be Parameter." ] .

# ─── Expert 경력 datatype: 자료형 검증 (존재 강제 안 함) ──────────
# retirementYear 는 은퇴자만, 등 — minCount 를 걸지 않는다. 목적은 어휘가 SHACL 에
# 보이고 자료형이 옳게 실렸음을 고정하는 것이다(부풀리기 아님 — 실제 데이터에 걸린다).
ont:Shape_ExpertCareer a sh:NodeShape ;
    sh:targetClass ont:Expert ;
    sh:property [ sh:path ont:hasCaseExperience ; sh:nodeKind sh:IRI ; sh:class ont:ExpertCase ] ;
    sh:property [ sh:path ont:age ;              sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:yearsExperience ;  sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:patentCount ;      sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ont:publicationCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ont:toeicScore ;       sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:retirementYear ;   sh:datatype xsd:gYear ] ;
    sh:property [ sh:path ont:lastActivity ;     sh:datatype xsd:date ] ;
    sh:property [ sh:path ont:hasNCT ;           sh:datatype xsd:boolean ] ;
    sh:property [ sh:path ont:education ;         sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:currentStatus ;     sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:formerEmployer ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:securityClearance ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:consultingAvailability ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:specialization ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:profileSummary ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:hourlyRateRange ;   sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:nationality ;       sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:hasCertification ;  sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:language ;          sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:majorProject ;      sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:preferredProjectType ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:workHistoryCountry ;   sh:datatype xsd:string ] .
