@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

sdkb:Etching a sdkb:ProcessStep ; rdfs:label "Etching" .
sdkb:Lithography a sdkb:ProcessStep ; rdfs:label "Lithography" .
sdkb:CMP a sdkb:ProcessStep ; rdfs:label "CMP" .

sdkb:P1020200000001 a sdkb:Patent ;
    rdfs:label "플라즈마 식각 균일도 개선 방법" ;
