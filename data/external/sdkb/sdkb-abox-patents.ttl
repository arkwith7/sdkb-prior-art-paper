    ont:valueChainStage "process" .

<https://w3id.org/sdkb/data/patent/kr_1020070097272> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "플래시 메모리 소자 및 그의 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "플래시 메모리 소자 및 그의 제조 방법이 개시된다. 이 방법은 반도체 기판 내부에 트렌치를 형성하는 단계 및 트렌치 내부에 터널 산화막, 플로팅 게이트, ONO 막 및 제어 게이트를 순차적으로 적층하여 형성하는 단계를 구비하는 것을 특징으로 한다. 그러므로, 플래시 메모리 소자의 게이트를 형성할 때, 성질이 서로 다른 막질 즉, 플로팅 게이트용 폴리, ONO 층, 제어 게이트용 폴리를 인시츄로 에칭하지 않으므로서, 이들 층들을 인시츄로 에칭시 발생하는 변화를 원천적으로 방지할 수 있어, 터널 산화막(52)의 두께 및 게이트 CD 조절을 용이하게 하고, 트렌치 형태로 게이트를 형성하여 깊이 조절을 통해 플래시 메모리 작동 전압을 용이하게 조절할 수 있도록 하는 효과를 갖는다. 결국, 종래의 플래시 메모리 소자보다 터널 산화막 및 게이트 CD 조절을 용이하게 하여 제품 특성의 재현성을 높일 수 있다.  플래시 메모리 소자, 플로팅 게이트, ONO 막, 제어 게이트, 트렌치" ;
    ont:applicationNumber "1020070097272" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/db_hitek> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2007-09-27"^^xsd:date ;
    ont:firstClaimText "1. (a) 반도체 기판 내부에 트렌치를 형성하는 단계; 및(b) 상기 트렌치 내부에 터널 산화막, 플로팅 게이트, ONO 막 및 제어 게이트를 순차적으로 적층하여 형성하는 단계를 구비하는 것을 특징으로 하는 플래시 메모리 소자의 제조 방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/H01L_21-8247>,
        <https://w3id.org/sdkb/data/ipc/H10B_69-00> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/kr_KR1020040025244A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020060120974A> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/kr_KR1020040025244A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020060120974A> ;
    ont:involvesMaterial <https://w3id.org/sdkb/data/material/sio2> ;
    ont:patentOffice "KR" ;
    ont:processFamily "lithography" ;
    ont:publicationDate "2009-04-01"^^xsd:date ;
    ont:publicationNumber "1020090032236" ;
    ont:realizesProcess <https://w3id.org/sdkb/data/process/etch>,
        <https://w3id.org/sdkb/data/process/lithography> ;
