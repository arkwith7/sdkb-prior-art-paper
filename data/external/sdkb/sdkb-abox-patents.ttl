<https://w3id.org/sdkb/data/patent/kr_1020137007216> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "텅스텐 타겟 및 그 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "평균입경을 수십 ㎛ 이하로 억제해 파티클의 발생을 억제한다. 텅스텐 분말의 예비 성형체를 제작한 후, 예비 성형체를 소결한다. 예비 성형체는, 그 상대밀도가 70% 이상 90% 이하, 산소 함유량이 100 ppm 이상 500 ppm 이하가 되도록 제작된다. 소결은, 열간 등방압 프레스법에 의해, 1700℃ 이상 1850℃ 이하로 실시한다. 이것에 의해, 20㎛ 이하, 표준편차 10㎛ 이하의 평균입경과, 99% 이상의 상대밀도와, 10 ppm 이하의 산소 농도를 가지는 텅스텐 타겟을 얻을 수 있다. 이러한 텅스텐 타겟은, 스퍼터 시의 파티클의 발생을 큰폭으로 감소시킬 수 있다." ;
    ont:applicationNumber "1020137007216" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/ulvac> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2011-09-21"^^xsd:date ;
    ont:firstClaimText "1. 70% 이상 90% 이하의 상대밀도와, 100 ppm 이상 500 ppm 이하의 산소 함유량을 가지는 텅스텐 분말의 예비 성형체를 제작하고, 상기 예비 성형체를 1700℃ 이상 1850℃ 이하의 온도로 열간 등방압 프레스법에 의해 소결하는, 텅스텐 타겟의 제조 방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/B22F_3-15>,
        <https://w3id.org/sdkb/data/ipc/C22C_1-04>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-34> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP03150356A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2001098364A> ;
