<https://w3id.org/sdkb/data/patent/kr_1020137006789> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "투명 도전막의 제조 방법 및 박막 태양 전지의 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "우수한 투명 도전막을 단시간에 제조할 수 있고, 고효율의 박막 태양 전지의 생산성을 향상시키는 투명 도전막의 제조 방법, 및 박막 태양 전지의 제조 방법을 제공한다. 스퍼터링 가스종으로서 Ar과 H  2  의 혼합 가스를 이용하고, 혼합 가스의 몰비가 H  2  /(Ar+H  2  ) = 0.01 ~ 0.43, 스퍼터링 가스압이 2.0 ~ 15.0 Pa, 기판 온도가 300 ~ 600℃의 조건하에서, 산화아연을 주성분으로 한 산화물 소결체 타겟을 이용하여, 투광성 기판(1) 상에 투명 도전막(2)을 형성한다. 그리고, 투명 도전막(2) 상에, 비정질 광전 변환 유닛(3), 이면 전극(5)을 순서대로 형성한다." ;
    ont:applicationNumber "1020137006789" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/sumitomo_metal_mining> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/gas_chemistry> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2011-08-23"^^xsd:date ;
    ont:firstClaimText "1. 산화아연을 주성분으로 한 산화물 소결체 타겟을 이용하여, 투광성 기판 상에 투명 도전막을 형성하는 투명 도전막의 제조 방법에 있어서, 스퍼터링 가스종으로서 Ar과 H2의 혼합 가스를 이용하고, 혼합 가스의 몰비가 H2/(Ar+H2) = 0.01 ~ 0.43, 스퍼터링 가스압이 2.0 ~ 15.0 Pa, 기판 온도가 300 ~ 600℃의 조건하에서 투명 도전막을 형성하는 것을 특징으로 하는 투명 도전막의 제조 방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C23C_14-08>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-34>,
        <https://w3id.org/sdkb/data/ipc/H10F_10-00> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP2010034232A>,
        <https://w3id.org/sdkb/data/patent/other_NovelpropertiesofAZOfilmsputteredinArH2ambientathightemperatureSunYanfengetalVacuum802006981985> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/jp_JP2010034232A>,
        <https://w3id.org/sdkb/data/patent/other_NovelpropertiesofAZOfilmsputteredinArH2ambientathightemperatureSunYanfengetalVacuum802006981985> ;
