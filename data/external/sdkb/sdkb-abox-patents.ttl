        <https://w3id.org/sdkb/data/ipc/H10D_30-67> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP03138980A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2008281988A>,
