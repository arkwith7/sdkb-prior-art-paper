        <https://w3id.org/sdkb/data/ipc/H10B_69-00>,
        <https://w3id.org/sdkb/data/ipc/H10D_30-68> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/kr_KR1020010036044A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020030022037A> ;
