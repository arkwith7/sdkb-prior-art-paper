    skos:prefLabel "스퍼터링 타겟, 스퍼터링 타겟의 제조 방법 및 박막의 형성 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "본 발명은 산화물 반도체를 사용하여 형성된 트랜지스터는 비정질 실리콘을 사용하여 형성된 트랜지스터에 비해 신뢰성이 떨어지는 경우가 있었다. 따라서, 본 발명에서는, 산화물 반도체를 사용하여 형성된 신뢰성이 높은 트랜지스터를 포함하는 반도체 소자를 제조한다. 결정의 c축 방향이 산화물 반도체의 상부 표면의 법선 벡터에 평행한 결정화도를 갖는 산화물 반도체를 포함하는 스퍼터링 타겟을 이용하는 스퍼터링 방법에 의해 산화물 반도체 막을 증착시킨다. 조성 비가 결정 구조를 얻을 수 있도록 원료를 혼합하여 타겟을 형성시킨다." ;
    ont:applicationNumber "1020127020228" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/semiconductor_energy_laboratory> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2012-05-28"^^xsd:date ;
    ont:firstClaimText "1. 스퍼터링 타겟에 있어서,c축 방향이 산화물 반도체 재료의 상부 표면의 법선 벡터에 평행한 결정화도를 갖는 산화물 반도체 재료를 포함하는, 스퍼터링 타겟." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C23C_14-34>,
        <https://w3id.org/sdkb/data/ipc/H10P_14-22> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP2011058012A>,
        <https://w3id.org/sdkb/data/patent/jp_JP7031950B2> ;
