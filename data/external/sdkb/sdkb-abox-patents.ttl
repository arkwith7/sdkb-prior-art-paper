    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/kr_KR1020090029488A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020090036771A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020090045132A> ;
