<https://w3id.org/sdkb/data/patent/kr_1020100078538> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "터널 절연층,비휘발성 메모리 소자,및 그 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "본 발명은 본 발명은 터널 절연층, 비휘발성 메모리 소자, 및 그 제조 방법에 관한 것이다. 보다 상세하게는 비휘발성 메모리 소자의 프로그램/소거 특성을 개선시키고 리텐션 특성을 강화시킬 수 있는 터널 절연층, 비휘발성 메모리 소자, 및 그 제조 방법에 관한 것이다.본 발명은 (a) 기판 상부에 절연층을 형성하는 단계; (b) 상기 절연층에 이온을 주입하여 상기 절연층 내부에 이온 도핑층을 형성하는 단계; 및 (c) 내부에 상기 이온 도핑층이 형성된 상기 절연층을 어닐링(annealing)하여 상기 절연층 내부에 절연층 분리 영역을 형성하는 단계를 포함하는 것을 특징으로 한다. 본 발명에 의하면 터널 절연층 내부에 질소 이온을 주입한 후 어닐링에 의해 규소-질소 결합을 포함하는 질화 영역인 절연층 분리 영역을 형성함으로써 비휘발성 메모리 소자에 적용하는 경우 소거 특성을 개선하고, 누설 전류를 현저하게 감소할 수 있으며, 리텐션 특성을 향상시키는 것이 가능한 효과를 갖는다." ;
    ont:applicationNumber "1020100078538" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/korea_advanced_institute_of_science_and_technology> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2010-08-13"^^xsd:date ;
