<https://w3id.org/sdkb/data/patent/kr_1020177018680> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "탄탈 스퍼터링 타깃 및 그 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "후방 산란 전자 회절법을 이용하여 타깃의 스퍼터면에 대해 수직한 단면인 압연면 법선법 방향 : ND 를 관찰하였을 때, {100} 면이 ND 로 배향되어 있는 결정립의 면적률이 30 % 이상인 탄탈 스퍼터링 타깃. 본 발명은, 하이파워 스퍼터 상황하에 있어서, 성막 속도를 적절히 제어하는 것이 가능한 탄탈 스퍼터링 타깃을 제공하는 것을 과제로 한다. 이와 같은 탄탈 타깃을 사용하여 스퍼터링 성막한 경우, 미세 배선에 있어서도, 막 두께의 균일성이 우수한 박막을 형성할 수 있음과 함께, 박막 형성 프로세스에 있어서의 생산성을 향상시킬 수 있다." ;
    ont:applicationNumber "1020177018680" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/jx_advanced_metals> ;
