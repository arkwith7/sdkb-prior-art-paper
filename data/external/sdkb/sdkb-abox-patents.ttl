        <https://w3id.org/sdkb/data/patent/jp_JP2019044253A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2020019994A> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/jp_JP2008116691A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2020019994A> ;
