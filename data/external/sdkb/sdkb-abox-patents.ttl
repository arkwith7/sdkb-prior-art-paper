        <https://w3id.org/sdkb/data/ipc/H10D_64-27> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP2017204655A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020140067922A>,
