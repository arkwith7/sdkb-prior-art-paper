        <https://w3id.org/sdkb/data/patent/wo_WO2008150032A1> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/us_US20050136679A1>,
        <https://w3id.org/sdkb/data/patent/wo_WO2008150032A1> ;
