<https://w3id.org/sdkb/data/patent/kr_1020210016843> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "물질막 형성방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "물질막 형성방법에 관해 개시되어 있다. 개시된 물질막 형성방법은 기판 상에 상기 기판의 일부 영역을 노출시키는 비감광성 마스크를 마련한 다음, 스퍼터(sputter)를 이용하여 상기 기판의 노출된 영역 상에 물질막을 형성하고, 상기 마스크를 제거한 다음에는 마스크가 제거된 기판과 물질막을 제1 가스 분위기하에서 열처리한다. 상기 물질막은 전이금속과 칼코겐 원소를 포함한다. 상기 스퍼터는 RF 마그네트론 스퍼터를 포함할 수 있다. 상기 열처리는 상기 물질막을 형성할 때보다 높은 온도에서 실시할 수 있다." ;
    ont:applicationNumber "1020210016843" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/research_business_foundation_sungkyunkwan_university>,
        <https://w3id.org/sdkb/data/organization/samsung_electronics> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/gas_chemistry>,
        <https://w3id.org/sdkb/data/skill/mask_engineering> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2021-02-05"^^xsd:date ;
    ont:firstClaimText "1. 기판 상에 상기 기판의 일부 영역을 노출시키는 비감광성 마스크를 마련하는 단계;스퍼터를 이용하여 상기 기판의 노출된 영역 상에 물질막을 형성하는 단계;상기 마스크를 제거하는 단계; 및상기 마스크가 제거된 기판과 물질막을 제1 가스 분위기하에서 열처리하는 단계;를 포함하고,상기 물질막은 전이금속과 칼코겐 원소를 포함하는 물질막 형성방법." ;
