<https://w3id.org/sdkb/data/patent/kr_1020070065442> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "반도체 구리 웨이퍼 연마용 씨엠피 슬러리 제조방법과 이에의해 제조한 씨엠피 슬러리"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "본 발명은 반도체 구리배선 연마(CMP)용 반도체 구리 웨이퍼 연마용 CMP 슬러리 제조방법과 이에 의해 제조한 CMP 슬러리에 관 한 것으로, 구리 웨이퍼의 평탄화 연마를 위하여 기존의 연마재에 비하여 연마율이 월등히 높고, 균일한 표면을 가지며, 연마 후에도 스크레치 발생이 적은 특성을 가지면서도 웨이퍼 세정시 흡착된 불순물 제거에 뛰어난 구리 웨이퍼 연마용 조성물과 그 제조 방법을 제공하기 위하여 탈 이온수에 SiO  2  ,  , 산화제, 유기산, 부식방지제, 계면활성제, pH조절제 또는 증착 방지제를 첨가하여 혼합물을 조성하여 제조하는데 이때 상기한 SiO  2  ,  의 경우에는 입자크기가 5 ~ 130nm의 것을 사용하며, 본 발명의 조성물은 pH가 1.5 ~ 4.5인 구리 웨이퍼의 평탄화 연마용 CMP슬러리 조성물을 제공하는 데 있다.  콜로이달 실리카, CMP Slurry, 연마율, 스크레치, 구리 웨이퍼." ;
    ont:applicationNumber "1020070065442" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/bnag_sang_yeon>,
        <https://w3id.org/sdkb/data/organization/kwon_o_yun>,
        <https://w3id.org/sdkb/data/organization/shin_dong_hee> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/slurry_management> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2007-06-29"^^xsd:date ;
    ont:firstClaimText "1. 반도체 구리 웨이퍼 연마용 CMP 슬러리 제조방법에 있어서,탈 이온수 1리터(L)에 대하여 입자크기가 5 ~ 130nm인 SiO2를 10 ~ 200g, 유기산 1 ~ 50g 및 부식방지제 0.01 ~ 10g을 혼합하여 이온교환법으로 콜로이달 실리카(Colloidal Silica)를 제조하고, 상기 콜로이달 실리카(Colloidal Silica)에 pH 조절제  0.1 ~ 10vol%와 계면활성제  0.001 ~ 0.5vol%를 첨가하여 이를 교반시킨 후 필터로 여과한 다음 과산화물 산화제 0.1 ~ 10vol%를 첨가하여 제조하는 것을 특징으로 하는 반도체 구리 웨이퍼 연마용 CMP 슬러리 제조방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C09G_1-02>,
        <https://w3id.org/sdkb/data/ipc/H10P_50-00>,
        <https://w3id.org/sdkb/data/ipc/H10P_52-00> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/kr_KR100697293B1>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020010035668A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020050002200A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020070042341A> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/kr_KR100697293B1>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020070042341A> ;
    ont:involvesMaterial <https://w3id.org/sdkb/data/material/copper>,
        <https://w3id.org/sdkb/data/material/sio2> ;
    ont:patentOffice "KR" ;
    ont:processFamily "materials" ;
    ont:publicationDate "2009-01-08"^^xsd:date ;
    ont:publicationNumber "1020090001221" ;
