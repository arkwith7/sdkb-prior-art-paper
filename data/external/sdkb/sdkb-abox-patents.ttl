<https://w3id.org/sdkb/data/patent/kr_1020187031762> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "스퍼터링 캐소드, 스퍼터링 장치 및 성막체의 제조 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "스퍼터링 캐소드는, 횡단면 형상이 서로 대향하는 한 쌍의 장변부를 가지는 관상의 형상을 가지고, 침식면이 내측을 향하고 있는 스퍼터링 타겟을 가진다. 이 스퍼터링 캐소드를 이용하고, 스퍼터링 타겟에 둘러싸인 공간의 상방에 있어서 스퍼터링 타겟의 장변부보다 폭이 좁은 성막 영역을 가지는 피성막체를 스퍼터링 타겟의 일단면에 평행하게, 또한 장변부에 수직인 방향으로 일정 속도로 이동시키면서, 스퍼터링 타겟의 내면을 따라 주회하는 플라스마가 발생하도록 방전을 행하여 스퍼터링 가스에 의해 발생하는 플라스마 중의 이온에 의해, 스퍼터링 타겟의 장변부의 내면을 스퍼터링 하여 피성막체의 성막 영역에 성막을 행한다." ;
    ont:applicationNumber "1020187031762" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/keihin_ramtech> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/gas_chemistry>,
        <https://w3id.org/sdkb/data/skill/plasma_diagnostics> ;
    ont:examinationStatus "거절결정(재심사)" ;
    ont:filingDate "2017-01-25"^^xsd:date ;
    ont:firstClaimText "1. 횡단면 형상이 서로 대향하는 한 쌍의 장변부를 가지는 관상의 형상을 가지고 침식면이 내측을 향하고 있는 스퍼터링 타겟과, 상기 스퍼터링 타겟의 외측에 설치된 영구자석과, 상기 영구자석의 외측에 설치된 요크를 가지고, 상기 영구 자석 및 상기 요크로 이루어지는 자기회로는, 스퍼터링시에 상기 스퍼터링 타겟의 내면의 근방에 이 내면을 따라 주회하는 플라즈마가 발생하는 것 같은 자력선을 발생하도록 형성되고, 스퍼터링시에 상기 플라즈마 중의 스퍼터링 가스의 이온에 의해 스퍼터링됨으로써 상기 침식면으로부터 상기 스퍼터링 타겟에 둘러싸인 공간의 외부로 스퍼터 입자가 튀어나오도록 구성되고,스퍼터링시에 피성막체가 상기 스퍼터링 타겟에 둘러싸인 공간의 외부에 설치되고, 상기 스퍼터링 타겟에 둘러싸인 공간의 외부로 튀오나오는 상기 스퍼터 입자를 사용하여 상기 피성막체에 성막을 행하는 것을 특징으로 하는 스퍼터링 캐소드." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C23C_14-34>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-35>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-56>,
