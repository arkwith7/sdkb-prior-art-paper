<https://w3id.org/sdkb/data/patent/kr_1020160061291> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "MEMS 트랜스듀서를 위한 시스템 및 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "실시예에 따라서, MEMS 트랜스듀서는 제 1 전극과, 제 2 전극의 주변부에서의 앵커에 고정된 제 2 전극과, 제 2 전극의 주변부에서의 앵커로부터 이격되어 있으며 제 1 전극 및 제 2 전극에 기계적으로 연결된 기계적 지지부를 포함한다. 기계적 지지부는 제 2 전극의 부분에 고정되어, 동작시에, 제 2 전극의 최대 편향이 제 2 전극의 주변부와 기계적 구조체와의 사이에서 발생한다." ;
    ont:applicationNumber "1020160061291" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/infineon_technologies_ag> ;
    ont:concernsDevice <https://w3id.org/sdkb/data/device/mems> ;
    ont:examinationStatus "거절결정(재심사)" ;
    ont:filingDate "2016-05-19"^^xsd:date ;
    ont:firstClaimText "1. 미세 전자 기계 시스템(MEMS; microelectromechanical system) 트랜스듀서로서,제 1 전극과, 자신의 주변부(a perimeter)에서 앵커(an anchor)에 고정된 제 2 전극과, 상기 제 2 전극의 상기 주변부에서의 상기 앵커로부터 이격되어 있으며, 상기 제 1 전극 및 상기 제 2 전극에 기계적으로 연결된 기계적 지지부(a mechanical support)를 포함하되, 상기 기계적 지지부는, 동작시에 상기 제 2 전극의 주변부와 상기 기계적 지지부와의 사이에서 상기 제 2 전극의 최대 편향(deflection)이 발생하도록, 상기 제 2 전극의 일부에 고정되는MEMS 트랜스듀서." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/B81B_3-00>,
        <https://w3id.org/sdkb/data/ipc/B81C_1-00> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP2012016802A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020140113546A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020150052794A>,
        <https://w3id.org/sdkb/data/patent/us_US20120148071A1>,
        <https://w3id.org/sdkb/data/patent/us_US20130221453A1> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/kr_KR1020140113546A>,
        <https://w3id.org/sdkb/data/patent/us_US20120148071A1> ;
    ont:patentOffice "KR" ;
    ont:processFamily "mems" ;
    ont:publicationDate "2016-11-30"^^xsd:date ;
