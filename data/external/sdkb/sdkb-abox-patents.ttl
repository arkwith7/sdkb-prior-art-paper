<https://w3id.org/sdkb/data/patent/kr_1020167023996> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "표면 처리 구리박 및 그 제조 방법, 프린트 배선판용 동장 적층판, 그리고 프린트 배선판"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "구리박과, 구리박의 적어도 편면에 마련되며, 수소 농도 1∼35원자% 및/또는 탄소 농도 1∼15원자%의 주로 실리콘으로 이루어지는 표면 처리층을 구비한, 표면 처리 구리박이 제공된다. 이 표면 처리 구리박은, 구리박을 준비하고, 이 구리박의 적어도 편면에, 수소 농도 1∼35원자% 및/또는 탄소 농도 1∼15원자%의 주로 실리콘으로 이루어지는 표면 처리층을 물리 기상 성막 또는 화학 기상 성막에 의해 형성함에 의해 제조할 수 있다. 본 발명에 따르면, 스퍼터링 등의 증착법에 의해 형성된 바와 같은 극히 평탄한 구리박 표면이어도 수지층과의 높은 밀착 강도를 실현 가능하며, 또한, 프린트 배선 기판의 파인피치화에 적합한 바람직한 절연 저항을 갖는 표면 처리층을 구비한 구리박을 제공할 수 있다." ;
    ont:applicationNumber "1020167023996" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/mitsui_kinzoku_company_limited> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2015-09-03"^^xsd:date ;
