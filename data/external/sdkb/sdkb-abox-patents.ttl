<https://w3id.org/sdkb/data/patent/kr_1020140083150> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "3차원 반도체 장치"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "3차원 반도체 장치가 제공된다. 이 장치는 기판 상에 제공된, 좌측, 중앙, 및 우측 블록들 및 상기 좌측 및 중앙 블록들 사이 및/또는 상기 우측 및 중앙 블록들 사이에 제공된 적어도 하나의 디코딩 블록을 포함할 수 있다. 상기 중앙 블록은 복수의 열들 및 복수의 층들을 구성하도록 배열된 복수의 제1라인들을 포함하고, 상기 적어도 하나의 디코딩 블록은 복수의 디코딩 그룹들을 포함할 수 있다. 이때, 상기 디코딩 그룹들 각각은 상기 제1라인들의 상기 열들 중의 상응하는 하나를 상기 좌측 및 우측 블록들 중의 하나에 선택적으로 연결하도록 구성될 수 있다." ;
    ont:applicationNumber "1020140083150" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/seongdong_kim> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2014-07-03"^^xsd:date ;
    ont:firstClaimText "1. 기판;상기 기판 상에 제공된, 좌측, 중앙, 및 우측 블록들; 및상기 좌측 및 중앙 블록들 사이 및/또는 상기 우측 및 중앙 블록들 사이에 제공된 적어도 하나의 디코딩 블록을 포함하되,상기 중앙 블록은 복수의 열들 및 복수의 층들을 구성하도록 배열된 복수의 제1라인들을 포함하고, 상기 적어도 하나의 디코딩 블록은 복수의 디코딩 그룹들을 포함하되, 상기 디코딩 그룹들 각각은 상기 제1라인들의 상기 열들 중의 상응하는 하나를 상기 좌측 및 우측 블록들 중의 하나에 선택적으로 연결하도록 구성되는 3차원 반도체 장치." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/H01L_21-8247>,
        <https://w3id.org/sdkb/data/ipc/H10B_69-00> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/kr_KR100827697B1>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020080034816A> ;
