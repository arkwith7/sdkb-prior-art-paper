        <https://w3id.org/sdkb/data/ipc/H10P_72-00>,
        <https://w3id.org/sdkb/data/ipc/H10P_95-90> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP10032328A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2010258359A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2014192179A>,
        <https://w3id.org/sdkb/data/patent/jp_JP2018018847A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020180067413A> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/jp_JP10032328A>,
