<https://w3id.org/sdkb/data/patent/kr_1020197004052> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "스퍼터링 타깃 및 스퍼터링 타깃의 제작 방법"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "신규 금속 산화물 또는 신규 스퍼터링 타깃을 제공한다. 스퍼터링 타깃은 도전 재료 및 절연 재료를 포함한다. 절연 재료는 원소 M1을 포함하는 산화물, 질화물, 또는 산질화물을 포함한다. 원소 M1은 Al, Ga, Si, Mg, Zr, Be 및 B에서 선택되는 1종 이상의 원소이다. 도전 재료는 인듐 및 아연을 포함하는 산화물, 질화물, 또는 산질화물을 포함한다. 금속 산화물막은 도전 재료와 절연 재료가 서로 분리되어 있는 스퍼터링 타깃을 사용하여 퇴적된다." ;
    ont:applicationNumber "1020197004052" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/semiconductor_energy_laboratory> ;
    ont:examinationStatus "거절결정(재심사)" ;
    ont:filingDate "2017-06-16"^^xsd:date ;
    ont:firstClaimText "1. 스퍼터링 타깃으로서,인듐 또는 아연, 또는 인듐 및 아연의 양쪽을 포함하는 도전 재료; 및원소 M1, 상기 원소 M1을 포함하는 질화물, 및 상기 원소 M1을 포함하는 산질화물 중 하나를 포함하는 절연 재료를 포함하고,상기 원소 M1은 Al, Ga, Si, Mg, Zr, Be 및 B에서 선택되는 2종 이상의 원소이고,상기 도전 재료와 상기 절연 재료는 서로 분리되어 있는, 스퍼터링 타깃." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C04B_35-453>,
