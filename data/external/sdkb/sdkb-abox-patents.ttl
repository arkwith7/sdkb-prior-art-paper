<https://w3id.org/sdkb/data/patent/kr_1020110143454> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "반도체용 접착 조성물 및 이를 포함하는 접착 필름"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "본 발명은 반도체용 접착 조성물 및 이를 포함하는 접착 필름에 관한 것이다. 보다 구체적으로 경화속도 증가를 통한 고접착 특성을 통해 PCB bake 공정, PCB plasma 공정을 생략할 수 있으며, 공정시간 단축을 위한 In-line 공정에 적용시 Wire bonding 공정 중 경화 반응이 일부 진행됨으로써, 경화공정(또는 Semi Cure 또는 B-stage)이 생략 또는 단축이 가능한 조성물에 관한 것이다. 경화공정의 생략 또는 단축이 가능하도록 경화제로 페놀수지와 아민 경화수지를 동시에 적용하며, 경화촉진제는 경화속도 증가를 위해 이미다졸계 또는 마이크로캡슐형 잠재성 경화제를 적용하는 것을 특징으로 한다." ;
    ont:applicationNumber "1020110143454" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/cheil_industries> ;
    ont:concernsDevice <https://w3id.org/sdkb/data/device/wire_bonding> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/plasma_diagnostics> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2011-12-27"^^xsd:date ;
    ont:firstClaimText "1. 120℃에서 5초 동안 칩 접착시 다이 쉐어 강도가 4 kgf/칩 이상이고, 150℃에서 20 분 경화 후 150℃에서의 저장탄성율이 2 ×106 dyne/cm2 이상인, 반도체 접착 필름." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C09J_163-00>,
        <https://w3id.org/sdkb/data/ipc/C09J_201-00>,
        <https://w3id.org/sdkb/data/ipc/C09J_7-00>,
        <https://w3id.org/sdkb/data/ipc/H01L_21-02> ;
