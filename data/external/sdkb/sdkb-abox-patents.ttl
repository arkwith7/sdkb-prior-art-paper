<https://w3id.org/sdkb/data/patent/kr_1020257012412> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "물리 기상 증착(PVD) 챔버를 위한 유리질 탄소 셔터 디스크"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "방법들 및 장치는, 물리 기상(PVD) 챔버에서 처리된 기판들의 결함들을 감소시킨다. 일부 실시예들에서, 프로세스 챔버의 내측 용적에 배치된 프로세스 키트를 세정하기 위한 방법은, PVD 챔버의 기판 지지부 상에 유리질 탄소 셔터 디스크를 위치시키는 단계; 탄소 기재의 물질들과 반응성인 플라즈마를 생성하기 위해, PVD 챔버의 내측 용적에 배치된 산소-함유 세정 가스를 에너자이징하는 단계; 및 탄소 기재의 물질이 부착되어 있는 프로세스 키트를, 프로세스 키트에 부착된 탄소 기재의 물질의 적어도 일부분을 제거하기 위해, 플라즈마에 노출되는 동안 가열하는 단계를 포함한다." ;
    ont:applicationNumber "1020257012412" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/applied_materials> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/chamber_conditioning>,
        <https://w3id.org/sdkb/data/skill/defect_analysis>,
        <https://w3id.org/sdkb/data/skill/gas_chemistry>,
        <https://w3id.org/sdkb/data/skill/plasma_diagnostics> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2023-09-18"^^xsd:date ;
    ont:firstClaimText "1. 물리 기상 증착(PVD) 챔버의 내측 용적에 배치된 프로세스 키트를 세정하기 위한 방법으로서,상기 PVD 챔버의 기판 지지부 상에 유리질 탄소 셔터 디스크를 위치시키는 단계;탄소 기재의 물질들과 반응성인 플라즈마를 생성하기 위해, 상기 PVD 챔버의 상기 내측 용적에 배치된 산소-함유 세정 가스를 에너자이징(energize)하는 단계; 및탄소 기재의 물질이 부착되어 있는 상기 프로세스 키트를, 상기 프로세스 키트에 부착된 상기 탄소 기재의 물질의 적어도 일부분을 제거하기 위해, 상기 플라즈마에 노출되는 동안 가열하는 단계를 포함하는, 방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C23C_14-50>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-56>,
        <https://w3id.org/sdkb/data/ipc/C23C_16-34>,
        <https://w3id.org/sdkb/data/ipc/H01J_37-32> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/kr_KR1020160090402A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020210156884A> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/kr_KR1020160090402A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020210156884A> ;
    ont:patentOffice "KR" ;
    ont:processFamily "etch" ;
    ont:publicationDate "2025-05-20"^^xsd:date ;
    ont:publicationNumber "1020250070074" ;
