<https://w3id.org/sdkb/data/patent/kr_1020210182856> a ont:Patent,
        ont:RejectedPatent ;
    dcterms:license "KIPRIS terms — academic use, no redistribution of full text"^^xsd:string ;
    dcterms:source "KIPRIS Plus API (getBibliographyDetailInfoSearch)"^^xsd:string ;
    skos:prefLabel "물리 기상 증착에 의한 포토레지스트들"@ko ;
    prov:wasGeneratedBy <https://w3id.org/sdkb/data/activity/sirp_ingest> ;
    ont:abstractText "실시예들은 기판 상에 금속 옥소 포토레지스트를 형성하는 방법을 포함한다. 일 실시예에서, 방법은 진공 챔버에 타겟을 제공하는 단계를 포함하며, 여기서, 타겟은 금속을 포함한다. 방법은, 탄화수소 가스 및 불활성 가스를 진공 챔버 내로 유동시키는 단계, 및 진공 챔버에서 플라즈마를 점화시키는 단계로 계속될 수 있다. 일 실시예에서, 방법은 추가로, 기판 상에 금속 옥소 포토레지스트를 증착하는 단계로 계속되며, 여기서, 금속 옥소 포토레지스트는 금속-탄소 결합들 및 금속-산소 결합들을 포함한다." ;
    ont:applicationNumber "1020210182856" ;
    ont:assignedTo <https://w3id.org/sdkb/data/organization/applied_materials> ;
    ont:concernsSkill <https://w3id.org/sdkb/data/skill/chamber_conditioning>,
        <https://w3id.org/sdkb/data/skill/gas_chemistry>,
        <https://w3id.org/sdkb/data/skill/plasma_diagnostics> ;
    ont:examinationStatus "거절결정(일반)" ;
    ont:filingDate "2021-12-20"^^xsd:date ;
    ont:firstClaimText "1. 기판 상에 금속 옥소 포토레지스트(metal oxo photoresist)를 형성하는 방법으로서, 진공 챔버에 타겟을 제공하는 단계 — 상기 타겟은 금속을 포함함 —; 탄화수소 가스 및 불활성 가스를 상기 진공 챔버 내로 유동시키는 단계; 상기 진공 챔버에서 플라즈마를 점화(striking)시키는 단계; 및 상기 기판 상에 상기 금속 옥소 포토레지스트를 증착하는 단계를 포함하며, 상기 금속 옥소 포토레지스트는 금속-탄소 결합들 및 금속-산소 결합들을 포함하는, 기판 상에 금속 옥소 포토레지스트를 형성하는 방법." ;
    ont:hasIPC <https://w3id.org/sdkb/data/ipc/C23C_14-12>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-34>,
        <https://w3id.org/sdkb/data/ipc/C23C_14-58>,
        <https://w3id.org/sdkb/data/ipc/G03F_7-004>,
        <https://w3id.org/sdkb/data/ipc/G03F_7-16> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/jp_JP2020084330A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020190060678A>,
        <https://w3id.org/sdkb/data/patent/us_US20050181130A1>,
        <https://w3id.org/sdkb/data/patent/wo_WO2020164735A1> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/jp_JP2020084330A>,
        <https://w3id.org/sdkb/data/patent/kr_KR1020190060678A>,
        <https://w3id.org/sdkb/data/patent/us_US20050181130A1>,
        <https://w3id.org/sdkb/data/patent/wo_WO2020164735A1> ;
