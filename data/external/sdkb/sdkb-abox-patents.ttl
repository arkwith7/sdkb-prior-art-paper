        <https://w3id.org/sdkb/data/ipc/C23C_16-52>,
        <https://w3id.org/sdkb/data/ipc/H01J_37-32>,
        <https://w3id.org/sdkb/data/ipc/H03H_7-40> ;
    ont:hasPriorArt <https://w3id.org/sdkb/data/patent/us_US08282983B1>,
        <https://w3id.org/sdkb/data/patent/us_US20080251207A1>,
        <https://w3id.org/sdkb/data/patent/us_US20130141455A1> ;
    ont:hasPriorArtExaminer <https://w3id.org/sdkb/data/patent/us_US08282983B1>,
        <https://w3id.org/sdkb/data/patent/us_US20080251207A1>,
        <https://w3id.org/sdkb/data/patent/us_US20130141455A1> ;
